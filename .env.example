# Copy to .env (never commit .env). In Prefect, use Secret blocks / env vars instead.

# Neon direct connection string for the ingestion (write) role (Console -> Connect,
# pooling off). DATABASE_URL is also accepted; postgresql+asyncpg://...?ssl=require is converted.
STOCKDATA_DB_URL=postgresql://<role>:<password>@ep-<endpoint-id>.<region>.neon.tech/<db>?sslmode=require

# Prefect Cloud
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=

# Optional overrides (defaults in src/stockdata/config.py)
# STOCKDATA_BATCH_SIZE=25
# STOCKDATA_CONCURRENCY=2
