# Copy to .env (never commit .env). In Prefect, use Secret blocks / env vars instead.

# Supabase *pooler* connection string for the ingestion (write) role.
# Direct db.<ref>.supabase.co is IPv6-only and usually unreachable from Serverless/CI.
STOCKDATA_DB_URL=postgresql://ingest_user.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Prefect Cloud
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=

# Optional overrides (defaults in src/stockdata/config.py)
# STOCKDATA_BATCH_SIZE=25
# STOCKDATA_CONCURRENCY=2
